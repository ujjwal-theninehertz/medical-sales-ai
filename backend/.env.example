ANTHROPIC_API_KEY=
CORS_ORIGINS=http://localhost:5173

# Chronos-2 is already fully cached locally after the first download; this skips the
# "check for a newer version" network call to Hugging Face Hub that from_pretrained() makes
# on every single call otherwise. Without it, heavy local API-key/HF usage can trip HF's
# unauthenticated rate limit and each chronos forecast call can hang for several minutes
# before finally succeeding -- confirmed live during backend testing (a ~10 minute stall,
# same root cause the original Streamlit app is equally exposed to, just never hit this hard
# before). Safe to leave on permanently once the model is cached; unset it only if you
# actually need to pull a new/updated model.
HF_HUB_OFFLINE=1
